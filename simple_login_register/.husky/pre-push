#!/bin/sh

echo ""
echo "🔍 Running pre-push checks..."
echo ""

# Type check backend
echo "📦 Type checking backend..."
cd backend || exit 1
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Backend type check failed! Push dibatalkan."
  exit 1
fi
echo "✅ Backend type check passed!"
echo ""

# Type check frontend
echo "📦 Type checking frontend..."
cd ../simple_login_register || exit 1
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Frontend type check failed! Push dibatalkan."
  exit 1
fi
echo "✅ Frontend type check passed!"
echo ""

# Lint frontend
echo "🔎 Linting frontend..."
npm run lint
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Lint check failed! Push dibatalkan."
  exit 1
fi
echo "✅ Lint check passed!"
echo ""

echo "🚀 All checks passed! Pushing..."
